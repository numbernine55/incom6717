rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User Profile
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('monthlyIncomeGoal' in data) || (data.monthlyIncomeGoal is number));
    }

    // Validation for Transaction
    function isValidTransaction(data) {
      return data.userId == request.auth.uid
        && (data.type == 'income' || data.type == 'expense')
        && data.amount is number && data.amount >= 0 && data.amount <= 1000000000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.date is string && data.date.size() <= 10
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50));
    }

    // Validation for Budget
    function isValidBudget(data) {
      return data.userId == request.auth.uid
        && data.month is string && data.month.size() <= 7
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.amount is number && data.amount >= 0 && data.amount <= 1000000000;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidTransaction(incoming());
      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid 
        && incoming().userId == request.auth.uid 
        && isValidTransaction(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Budgets Collection
    match /budgets/{budgetId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidBudget(incoming());
      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid 
        && incoming().userId == request.auth.uid 
        && isValidBudget(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
